# Env for the E2E pipeline only. Points at the ephemeral stack started by
# docker-compose.test.yml (separate ports from dev, see npm run test:e2e).
# Safe to commit: local-only placeholders, never used against real infra.

S3_ENDPOINT=http://localhost:9101
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=recordings-e2e
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9101/recordings-e2e
S3_CORS_ORIGIN=*

MONGODB_URI=mongodb://localhost:27018/screen-capture-e2e

NODE_ENV=test
