# Copy this file to .env.local and fill in real values for your machine.
# .env.local is git-ignored — never commit real secrets. Only this file
# (with placeholders) is versioned.

# --- Storage S3-compatible ---
# Local: RustFS (see docker-compose.yml). Production: Cloudflare R2 (Fase 12/13 del plan).
S3_ENDPOINT=http://localhost:9001
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=recordings
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
# Public base URL used to build the playable link for each object
# (local: the RustFS endpoint itself; prod: your R2/CDN domain).
S3_PUBLIC_URL=http://localhost:9001/recordings
# Origin allowed to upload directly to the bucket (browser -> storage is
# cross-origin). "*" is fine for local dev.
S3_CORS_ORIGIN=*

# --- Producción (Cloudflare R2) — referencia, no usar en local ---
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ACCESS_KEY=<r2-access-key-id>
# S3_SECRET_KEY=<r2-secret-access-key>
# S3_BUCKET=recordings
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=false
# S3_PUBLIC_URL=https://<tu-dominio-o-cdn>/recordings
# S3_CORS_ORIGIN=https://<tu-dominio-de-produccion>

# --- Base de datos ---
# Local: MongoDB en Docker (ver docker-compose.yml).
MONGODB_URI=mongodb://localhost:27017/screen-capture

# --- Producción (MongoDB Atlas) — referencia, no usar en local ---
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/screen-capture?retryWrites=true&w=majority

# --- App ---
NODE_ENV=development
